/* AM437x GP EVM */

/dts-v1/;

#include "am4372.dtsi"
#include <dt-bindings/pinctrl/am43xx.h>
#include <dt-bindings/pwm/pwm.h>
#include <dt-bindings/gpio/gpio.h>

/ {
	model = "MakerBot Macho Man RevA";
	compatible = "makerbot,macho-man-reva","ti,am4372","ti,am43", "ti,cpsw";

	aliases {};

	evm_v3_3d: fixedregulator-v3_3d {
		compatible = "regulator-fixed";
		regulator-name = "evm_v3_3d";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		enable-active-high;
	};

	mbi2c: i2c-gpio-0 {
		compatible = "i2c-gpio";
		gpios = <&gpio5 20 0>, /* sda */
			<&gpio5 19 0>; /* scl */
		/*i2c-gpio,sda-open-drain;
		i2c-gpio,scl-open-drain;*/
		i2c-gpio,delay-us = <4>;
		#address-cells = <1>;
		#size-cells = <0>;
	};
};

&am43xx_pinmux {
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&debugss_pins &unused_pins>;
	pinctrl-1 = <>;
	
	/* i2c0 pins used for the pcf8523 hardware RTC */
	i2c0_pins: i2c0_pins {
		pinctrl-single,pins = <
			0x188 (PIN_INPUT_PULLUP | SLEWCTRL_FAST | MUX_MODE0)	/* i2c0_sda.i2c0_sda */
			0x18C (PIN_INPUT_PULLUP | SLEWCTRL_FAST | MUX_MODE0)	/* i2c0_scl.i2c0_scl */
		>;
	};

	// on macho man rev a, i2c-1 is mis laid out: sda is connected to scl and vice
	// versa. so we'll use an i2c gpio for it.
	i2c1_pins: i2c1_pins {
		pinctrl-single,pins = <
			0x208 (PIN_INPUT | MUX_MODE7 | SLEWCTRL_FAST)	/* cam0_data0 (gpio5_19)*/
			0x20C (PIN_INPUT | MUX_MODE7 | SLEWCTRL_FAST)	/* cam0_data1 (gpio5_20)*/
		>;
	};

	i2c2_pins: i2c2_pins {
		pinctrl-single,pins = <
			0x1E8 (PIN_INPUT_PULLUP | SLEWCTRL_FAST | MUX_MODE3)	/* cam1_data1 / i2c2_sda*/
			0x1EC (PIN_INPUT_PULLUP | SLEWCTRL_FAST | MUX_MODE3)	/* cam1_data1 / i2c2_sdl */
		>;
	};

	emmc_pins_default: emmc_pins_default {
		pinctrl-single,pins = <
			0x020 (PIN_INPUT_PULLUP | MUX_MODE2)	/* gpmc_ad8.mmc1_dat0 */
			0x024 (PIN_INPUT_PULLUP | MUX_MODE2)	/* gpmc_ad9.mmc1_dat1 */
			0x028 (PIN_INPUT_PULLUP | MUX_MODE2)	/* gpmc_ad10.mmc1_dat2 */
			0x02C (PIN_INPUT_PULLUP | MUX_MODE2)	/* gpmc_ad11.mmc1_dat3 */
			0x030 (PIN_INPUT_PULLUP | MUX_MODE2)	/* gpmc_ad12.mmc1_dat4 */
			0x034 (PIN_INPUT_PULLUP | MUX_MODE2)	/* gpmc_ad13.mmc1_dat5 */
			0x038 (PIN_INPUT_PULLUP | MUX_MODE2)	/* gpmc_ad14.mmc1_dat6 */
			0x03C (PIN_INPUT_PULLUP | MUX_MODE2)	/* gpmc_ad15.mmc1_dat7 */
			0x080 (PIN_INPUT_PULLUP | MUX_MODE2)	/* gpmc_csn1.mmc1_clk */
			0x084 (PIN_INPUT_PULLUP | MUX_MODE2)	/* gpmc_csn2.mmc1_cmd */
		>;
	};

	emmc_pins_sleep: emmc_pins_sleep {
		pinctrl-single,pins = <
			0x020 (PIN_INPUT_PULLDOWN | MUX_MODE7)	/* gpmc_ad8 */
			0x024 (PIN_INPUT_PULLDOWN | MUX_MODE7)	/* gpmc_ad9 */
			0x028 (PIN_INPUT_PULLDOWN | MUX_MODE7)	/* gpmc_ad10 */
			0x02C (PIN_INPUT_PULLDOWN | MUX_MODE7)	/* gpmc_ad11 */
			0x030 (PIN_INPUT_PULLDOWN | MUX_MODE7)	/* gpmc_ad12 */
			0x034 (PIN_INPUT_PULLDOWN | MUX_MODE7)	/* gpmc_ad13 */
			0x038 (PIN_INPUT_PULLDOWN | MUX_MODE7)	/* gpmc_ad14 */
			0x03C (PIN_INPUT_PULLDOWN | MUX_MODE7)	/* gpmc_ad15 */
			0x080 (PIN_INPUT_PULLDOWN | MUX_MODE7)	/* gpmc_csn1.gpio1_30 */
			0x084 (PIN_INPUT_PULLDOWN | MUX_MODE7)	/* gpmc_csn2.gpio1_31 */
		>;
	};

	cpsw_default: cpsw_default {
		pinctrl-single,pins = <
			0x78 ( PIN_INPUT | MUX_MODE1 ) /* (A3) gpmc_be1n.gmii2_col */
			0x70 ( PIN_INPUT | MUX_MODE1 ) /* (A2) gpmc_wait0.gmii2_crs */
			0x74 ( PIN_INPUT_PULLDOWN | MUX_MODE1 ) /* (B3) gpmc_wpn.gmii2_rxer */
			0x40 ( PIN_OUTPUT | MUX_MODE1 ) /* (C3) gpmc_a0.gmii2_txen */
			0x44 ( PIN_INPUT_PULLDOWN | MUX_MODE1 ) /* (C5) gpmc_a1.gmii2_rxdv */
			0x58 ( PIN_INPUT | MUX_MODE1 ) /* (E8) gpmc_a6.gmii2_txclk */
			0x5c ( PIN_INPUT | MUX_MODE1 ) /* (F6) gpmc_a7.gmii2_rxclk */
			0x54 ( PIN_OUTPUT | MUX_MODE1 ) /* (E7) gpmc_a5.gmii2_txd0 */
			0x50 ( PIN_OUTPUT | MUX_MODE1 ) /* (D7) gpmc_a4.gmii2_txd1 */
			0x4c ( PIN_OUTPUT | MUX_MODE1 ) /* (A4) gpmc_a3.gmii2_txd2 */
			0x48 ( PIN_OUTPUT | MUX_MODE1 ) /* (C6) gpmc_a2.gmii2_txd3 */
			0x6c ( PIN_INPUT | MUX_MODE1 ) /* (D8) gpmc_a11.gmii2_rxd0 */
			0x68 ( PIN_INPUT | MUX_MODE1 ) /* (G8) gpmc_a10.gmii2_rxd1 */
			0x64 ( PIN_INPUT | MUX_MODE1 ) /* (B4) gpmc_a9.gmii2_rxd2 */
			0x60 ( PIN_INPUT | MUX_MODE1 ) /* (F7) gpmc_a8.gmii2_rxd3 */
			0x270 (PIN_OUTPUT | MUX_MODE3)	/* xdma_evt_intr0 as clkout0*/
			0x000 (PIN_OUTPUT_PULLUP | MUX_MODE7)	/* gpmc_ad0 */
		>;
	};

	cpsw_sleep: cpsw_sleep {
		pinctrl-single,pins = <
			0x78 (PIN_INPUT_PULLDOWN | MUX_MODE7) /* (A3) gpmc_be1n.gmii2_col */
			0x70 (PIN_INPUT_PULLDOWN | MUX_MODE7) /* (A2) gpmc_wait0.gmii2_crs */
			0x74 (PIN_INPUT_PULLDOWN | MUX_MODE7) /* (B3) gpmc_wpn.gmii2_rxer */
			0x40 (PIN_OUTPUT_PULLDOWN | MUX_MODE7) /* (C3) gpmc_a0.gmii2_txen */
			0x44 (PIN_INPUT_PULLDOWN | MUX_MODE7) /* (C5) gpmc_a1.gmii2_rxdv */
			0x58 (PIN_INPUT_PULLDOWN | MUX_MODE7) /* (E8) gpmc_a6.gmii2_txclk */
			0x5c (PIN_INPUT_PULLDOWN | MUX_MODE7) /* (F6) gpmc_a7.gmii2_rxclk */
			0x54 (PIN_OUTPUT_PULLDOWN | MUX_MODE7) /* (E7) gpmc_a5.gmii2_txd0 */
			0x50 (PIN_OUTPUT_PULLDOWN | MUX_MODE7) /* (D7) gpmc_a4.gmii2_txd1 */
			0x4c (PIN_OUTPUT_PULLDOWN | MUX_MODE7) /* (A4) gpmc_a3.gmii2_txd2 */
			0x48 (PIN_OUTPUT_PULLDOWN | MUX_MODE7) /* (C6) gpmc_a2.gmii2_txd3 */
			0x6c (PIN_INPUT_PULLDOWN | MUX_MODE7) /* (D8) gpmc_a11.gmii2_rxd0 */
			0x68 (PIN_INPUT_PULLDOWN | MUX_MODE7) /* (G8) gpmc_a10.gmii2_rxd1 */
			0x64 (PIN_INPUT_PULLDOWN | MUX_MODE7) /* (B4) gpmc_a9.gmii2_rxd2 */
			0x60 (PIN_INPUT_PULLDOWN | MUX_MODE7) /* (F7) gpmc_a8.gmii2_rxd3 */
			0x270 (PIN_OUTPUT | MUX_MODE3)	/* xdma_evt_intr0 as clkout0*/
			0x000 (PIN_OUTPUT_PULLUP | MUX_MODE7)	/* gpmc_ad0 */
		>;
	};

	

	davinci_mdio_default: davinci_mdio_default {
		pinctrl-single,pins = <
			/* MDIO */
			0x148 (PIN_INPUT | SLEWCTRL_FAST | MUX_MODE0)	/* mdio_data.mdio_data */
			0x14c (PIN_OUTPUT | MUX_MODE0)			/* mdio_clk.mdio_clk */
		>;
	};

	davinci_mdio_sleep: davinci_mdio_sleep {
		pinctrl-single,pins = <
			/* MDIO reset value */
			0x148 (PIN_INPUT | PULL_DISABLE | MUX_MODE7)
			0x14c (PIN_INPUT | PULL_DISABLE | MUX_MODE7)
		>;
	};

	uart0_pins_default: uart0_pins_default {
		pinctrl-single,pins = <
			0x168 (DS0_PULL_UP_DOWN_EN | INPUT_EN | MUX_MODE0)	/* uart0_ctsn.uart0_ctsn */
			0x16C (DS0_PULL_UP_DOWN_EN | INPUT_EN | MUX_MODE0)	/* uart0_rtsn.uart0_rtsn */
			0x170 (PIN_INPUT_PULLUP | SLEWCTRL_FAST | DS0_PULL_UP_DOWN_EN | MUX_MODE0) /* uart0_rxd.uart0_rxd */
			0x174 (PIN_INPUT | PULL_DISABLE | SLEWCTRL_FAST | DS0_PULL_UP_DOWN_EN | MUX_MODE0) /* uart0_txd.uart0_txd */
		>;
	};

	uart0_pins_sleep: uart0_pins_sleep {
		pinctrl-single,pins = <
			0x168 (DS0_PULL_UP_DOWN_EN | INPUT_EN | MUX_MODE7)	/* uart0_ctsn */
			0x16C (DS0_PULL_UP_DOWN_EN | INPUT_EN | MUX_MODE7)	/* uart0_ctsn */
			0x170 (PIN_INPUT_PULLUP | SLEWCTRL_FAST | DS0_PULL_UP_DOWN_EN | MUX_MODE0) /* uart0_rxd.uart0_rxd */
			0x174 (PIN_INPUT_PULLDOWN | SLEWCTRL_FAST | DS0_PULL_UP_DOWN_EN | MUX_MODE0) /* uart0_txd.uart0_txd */
		>;
	};

	debugss_pins: pinmux_debugss_pins {
		pinctrl-single,pins = <
			0x290 (PIN_INPUT_PULLDOWN)
			0x294 (PIN_INPUT_PULLDOWN)
			0x298 (PIN_INPUT_PULLDOWN)
			0x29C (PIN_INPUT_PULLDOWN)
			0x2A0 (PIN_INPUT_PULLDOWN)
			0x2A4 (PIN_INPUT_PULLDOWN)
			0x2A8 (PIN_INPUT_PULLDOWN)
		>;
	};

	pruss_pins: pruss_pins {
		pinctrl-single,pins = <
			0x190 (PIN_OUTPUT | MUX_MODE5)	/* mcasp0_aclkx (pru gpo0)*/
			0x194 (PIN_OUTPUT | MUX_MODE5)	/* mcasp0_fsx (pru gpo1)*/
			0x198 (PIN_OUTPUT | MUX_MODE5)	/* mcasp0_axr0 (pru gpo2)*/
			0x19C (PIN_OUTPUT | MUX_MODE5)	/* mcasp0_ahclkr (pru gpo3)*/
			0x1A0 (PIN_OUTPUT | MUX_MODE5)	/* mcasp0_aclkr (pru gpo4)*/
			0x1A4 (PIN_OUTPUT | MUX_MODE5)	/* mcasp0_fsr (pru gpo5)*/
			0x1A8 (PIN_OUTPUT | MUX_MODE5)	/* mcasp0_axr1 (pru gpo6)*/
			0x1AC (PIN_OUTPUT | MUX_MODE5)	/* mcasp0_ahclkx (pru gpo7) */
			0x0F0 (PIN_OUTPUT | MUX_MODE5)	/* mmc0_dat3 (pru gpo8)*/
			0x0F4 (PIN_OUTPUT | MUX_MODE5)	/* mmc0_dat2 (pru gpo9)*/
			0x0F8 (PIN_OUTPUT | MUX_MODE5)	/* mmc0_dat1 (pru gpo10)*/
			0x0FC (PIN_OUTPUT | MUX_MODE5)	/* mmc0_dat0 (pru gpo11)*/
			0x100 (PIN_OUTPUT | MUX_MODE5)	/* mmc0_clk (pru gpo12)*/
			0x104 (PIN_OUTPUT | MUX_MODE5)	/* mmc0_cmd (pri gpo13)*/
			0x1C0 (PIN_INPUT_PULLDOWN | MUX_MODE5)	/* cam0_pclk (pru gpi14) INPUT*/
			0x1C4 (PIN_INPUT_PULLDOWN | MUX_MODE5)	/* cam0_data8 (pru gpi15) INPUT*/
			0x1C8 (PIN_INPUT_PULLDOWN | MUX_MODE5)	/* cam0_data9 (pru gpo16)*/
			0x1CC (PIN_OUTPUT | MUX_MODE3)	/* cam1_data9 (pru gpo17)*/
			0x228 (PIN_OUTPUT | MUX_MODE4)	/* uart3_rxd (pru gpo18)*/
			0x22C (PIN_OUTPUT | MUX_MODE4)	/* uart3_txd (pru gpo19)*/
			// pr0_pru1 pins begin here
			0x1D0 (PIN_OUTPUT | MUX_MODE4)	/* cam1_data8 (pru1 gpo0)*/
			0x1D4 (PIN_OUTPUT | MUX_MODE3)	/* cam1_hd (pru1 gpo1)*/
			0x1D8 (PIN_OUTPUT | MUX_MODE3)	/* cam1_vd (pru1 gpo2)*/
			0x1DC (PIN_OUTPUT | MUX_MODE3)	/* cam1_pclk (pru1 gpo3)*/
			0x1F0 (PIN_OUTPUT | MUX_MODE4)	/* cam1_data2 (pru1 gpo10)*/
			0x1F4 (PIN_OUTPUT | MUX_MODE4)	/* cam1_data3 (pru1 gpo11)*/
			0x1F8 (PIN_OUTPUT | MUX_MODE4)	/* cam1_data4 (pru1 gpo12)*/
			0x1FC (PIN_OUTPUT | MUX_MODE4)	/* cam1_data5 (pru1 gpo13)*/
			0x200 (PIN_OUTPUT | MUX_MODE4)	/* cam1_data6 (pru1 gpo14)*/
			0x204 (PIN_OUTPUT | MUX_MODE4)	/* cam1_data7 (pru1 gpo15)*/
		>;
	};

	dss_pins_default: dss_pins_default {
		pinctrl-single,pins = <
			0x234 (PIN_OUTPUT_PULLDOWN | MUX_MODE7)	/* uart3_rtsn.gpio5_1 (bklight)*/
			0x0A0 (PIN_OUTPUT_PULLUP | MUX_MODE0)	/* lcd_data0.lcd_data0 */
			0x0A4 (PIN_OUTPUT_PULLUP | MUX_MODE0)	/* lcd_data1.lcd_data1 */
			0x0A8 (PIN_OUTPUT_PULLUP | MUX_MODE0)	/* lcd_data2.lcd_data2 */
			0x0AC (PIN_OUTPUT_PULLUP | MUX_MODE0)	/* lcd_data3.lcd_data3 */
			0x0B0 (PIN_OUTPUT_PULLUP | MUX_MODE0)	/* lcd_data4.lcd_data4 */
			0x0B4 (PIN_OUTPUT_PULLUP | MUX_MODE0)	/* lcd_data5.lcd_data5 */
			0x0B8 (PIN_OUTPUT_PULLUP | MUX_MODE0)	/* lcd_data6.lcd_data6 */
			0x0BC (PIN_OUTPUT_PULLUP | MUX_MODE0)	/* lcd_data7.lcd_data7 */
			0x0C0 (PIN_OUTPUT_PULLUP | MUX_MODE0)	/* lcd_data8.lcd_data8 */
			0x0C4 (PIN_OUTPUT_PULLUP | MUX_MODE0)	/* lcd_data9.lcd_data9 */
			0x0C8 (PIN_OUTPUT_PULLUP | MUX_MODE0)	/* lcd_data10.lcd_data10 */
			0x0CC (PIN_OUTPUT_PULLUP | MUX_MODE0)	/* lcd_data11.lcd_data11 */
			0x0D0 (PIN_OUTPUT_PULLUP | MUX_MODE0)	/* lcd_data12.lcd_data12 */
			0x0D4 (PIN_OUTPUT_PULLUP | MUX_MODE0)	/* lcd_data13.lcd_data13 */
			0x0D8 (PIN_OUTPUT_PULLUP | MUX_MODE0)	/* lcd_data14.lcd_data14 */
			0x0DC (PIN_OUTPUT_PULLUP | MUX_MODE0)	/* lcd_data15.lcd_data15 */
			0x0E0 (PIN_OUTPUT_PULLUP | MUX_MODE0)	/* lcd_vsync.lcd_vsync */
			0x0E4 (PIN_OUTPUT_PULLUP | MUX_MODE0)	/* lcd_hsync.lcd_hsync */
			0x0E8 (PIN_OUTPUT_PULLUP | MUX_MODE0)	/* lcd_pclk.lcd_pclk */
			0x0EC (PIN_OUTPUT_PULLUP | MUX_MODE0)	/* lcd_ac_bias_en.lcd_ac_bias_en */
		>;
	};

	dss_pins_sleep: dss_pins_sleep {
		pinctrl-single,pins = <
			0x234 (PIN_INPUT_PULLDOWN | MUX_MODE7)	/* uart3_rtsn */
			0x0A0 (PIN_INPUT_PULLDOWN | MUX_MODE7)	/* lcd_data0 */
			0x0A4 (PIN_INPUT_PULLDOWN | MUX_MODE7)	/* lcd_data1 */
			0x0A8 (PIN_INPUT_PULLDOWN | MUX_MODE7)	/* lcd_data2 */
			0x0AC (PIN_INPUT_PULLDOWN | MUX_MODE7)	/* lcd_data3 */
			0x0B0 (PIN_INPUT_PULLDOWN | MUX_MODE7)	/* lcd_data4 */
			0x0B4 (PIN_INPUT_PULLDOWN | MUX_MODE7)	/* lcd_data5 */
			0x0B8 (PIN_INPUT_PULLDOWN | MUX_MODE7)	/* lcd_data6 */
			0x0BC (PIN_INPUT_PULLDOWN | MUX_MODE7)	/* lcd_data7 */
			0x0C0 (PIN_INPUT_PULLDOWN | MUX_MODE7)	/* lcd_data8 */
			0x0C4 (PIN_INPUT_PULLDOWN | MUX_MODE7)	/* lcd_data9 */
			0x0C8 (PIN_INPUT_PULLDOWN | MUX_MODE7)	/* lcd_data10 */
			0x0CC (PIN_INPUT_PULLDOWN | MUX_MODE7)	/* lcd_data11 */
			0x0D0 (PIN_INPUT_PULLDOWN | MUX_MODE7)	/* lcd_data12 */
			0x0D4 (PIN_INPUT_PULLDOWN | MUX_MODE7)	/* lcd_data13 */
			0x0D8 (PIN_INPUT_PULLDOWN | MUX_MODE7)	/* lcd_data14 */
			0x0DC (PIN_INPUT_PULLDOWN | MUX_MODE7)	/* lcd_data15 */
			0x0E0 (PIN_INPUT_PULLDOWN | MUX_MODE7)	/* lcd_vsync */
			0x0E4 (PIN_INPUT_PULLDOWN | MUX_MODE7)	/* lcd_hsync */
			0x0E8 (PIN_INPUT_PULLDOWN | MUX_MODE7)	/* lcd_pclk */
			0x0EC (PIN_INPUT_PULLDOWN | MUX_MODE7)	/* lcd_ac_bias_en */
		>;
	};

	edt_ft5xx6_ts_pins: edt_ft5xx6_ts_pins {
		pinctrl-single,pins = <
			0x264 (PIN_INPUT | MUX_MODE7)	/* spi2_d0.gpio3_22 (ts interrupt) */
		>;
	};

	ehrpwm1_pins: ehrpwm1_pins {
		pinctrl-single,pins = <
			0x158 (PIN_OUTPUT | MUX_MODE8)	/* spi0_d1 (eHRPWM1A)*/
			0x15C (PIN_OUTPUT | MUX_MODE8)	/* spi0_cs0 (eHRPWM1B)*/
		>;
	};

	ehrpwm3_pins: ehrpwm3_pins {
		pinctrl-single,pins = <
			0x218 (PIN_OUTPUT | MUX_MODE6)	/* cam0_data4 (eHRPWM3A)*/
			0x21C (PIN_OUTPUT | MUX_MODE6)	/* cam0_data5 (eHRPWM3B)*/
		>;
	};

	ehrpwm5_pins: ehrpwm5_pins {
		pinctrl-single,pins = <
			0x230 (PIN_OUTPUT | MUX_MODE6)	/* uart3_ctsn (eHRPWM5A)*/
		>;
	};

	unused_pins: unused_pins {
		pinctrl-single,pins = <
			0x004 (PIN_INPUT_PULLDOWN | MUX_MODE7)	/* gpmc_ad1 */
			0x008 (PIN_INPUT_PULLDOWN | MUX_MODE7)	/* gpmc_ad2 */
			0x00C (PIN_INPUT_PULLDOWN | MUX_MODE7)	/* gpmc_ad3 */
			0x010 (PIN_INPUT_PULLDOWN | MUX_MODE7)	/* gpmc_ad4 */
			0x014 (PIN_INPUT_PULLDOWN | MUX_MODE7)	/* gpmc_ad5 */
			0x018 (PIN_INPUT_PULLDOWN | MUX_MODE7)	/* gpmc_ad6 */
			0x01C (PIN_INPUT_PULLDOWN | MUX_MODE7)	/* gpmc_ad7 */
			0x07C (PIN_INPUT_PULLDOWN | MUX_MODE7)	/* gpmc_csn0  */
			0x088 (PIN_INPUT_PULLDOWN | MUX_MODE7)	/* gpmc_csn3 */
			0x08C (PIN_OUTPUT_PULLUP | MUX_MODE7)	/* gpmc_clk / gpio2.1 / pwr-main */
			0x090 (PIN_OUTPUT_PULLUP | MUX_MODE7)	/* gpmc_advn_ale / gpio2.2 / 12v en */
			0x094 (PIN_INPUT_PULLDOWN | MUX_MODE7)	/* gpmc_oen_ren */
			0x098 (PIN_INPUT_PULLDOWN | MUX_MODE7)	/* gpmc_wen */
			0x09C (PIN_INPUT_PULLDOWN | MUX_MODE7)	/* gpmc_be0n_cle */
			0x108 (PIN_INPUT_PULLDOWN | MUX_MODE7)	/* mii1_col */
			0x10C (PIN_INPUT_PULLDOWN | MUX_MODE7)	/* mii1_crs */
			0x110 (PIN_INPUT_PULLDOWN | MUX_MODE7)	/* mii1_rxerr */
			0x114 (PIN_INPUT_PULLDOWN | MUX_MODE7)	/* mii1_txen */
			0x118 (PIN_INPUT_PULLDOWN | MUX_MODE7)	/* mii1_rxdv */
			0x11C (PIN_INPUT_PULLDOWN | MUX_MODE7)	/* mii1_txd3 */
			0x120 (PIN_INPUT_PULLDOWN | MUX_MODE7)	/* mii1_txd2 */
			0x124 (PIN_INPUT_PULLDOWN | MUX_MODE7)	/* mii1_txd1 */
			0x128 (PIN_INPUT_PULLDOWN | MUX_MODE7)	/* mii1_txd0 */
			0x12C (PIN_INPUT_PULLDOWN | MUX_MODE7)	/* mii1_txclk */
			0x130 (PIN_INPUT_PULLDOWN | MUX_MODE7)	/* mii1_rxclk */
			0x134 (PIN_INPUT_PULLDOWN | MUX_MODE7)	/* mii1_rxd3 */
			0x138 (PIN_INPUT_PULLDOWN | MUX_MODE7)	/* mii1_rxd2 */
			0x13C (PIN_INPUT_PULLDOWN | MUX_MODE7)	/* mii1_rxd1 */
			0x140 (PIN_INPUT_PULLDOWN | MUX_MODE7)	/* mii1_rxd0 */
			0x144 (PIN_INPUT_PULLDOWN | MUX_MODE7)	/* rmii1_refclk */
			0x150 (PIN_INPUT_PULLDOWN | MUX_MODE7)	/* spi0_sclk */
			0x154 (PIN_INPUT_PULLDOWN | MUX_MODE7)	/* spi0_d0 */
			0x160 (PIN_INPUT_PULLDOWN | MUX_MODE7)	/* spi0_cs1 */
			0x164 (PIN_INPUT_PULLDOWN | MUX_MODE7)	/* ecap0_in_pwm0_out */
			0x178 (PIN_INPUT_PULLDOWN | MUX_MODE7)	/* uart1_ctsn */
			0x17C (PIN_INPUT_PULLDOWN | MUX_MODE7)	/* uart1_rtsn */
			0x180 (PIN_INPUT_PULLDOWN | MUX_MODE7)	/* uart1_rxd */
			0x184 (PIN_INPUT_PULLDOWN | MUX_MODE7)	/* uart1_txd */
			0x1B0 (PIN_INPUT_PULLDOWN | MUX_MODE7)	/* cam0_hd */
			0x1B4 (PIN_INPUT_PULLDOWN | MUX_MODE7)	/* cam0_vd */
			0x210 (PIN_INPUT_PULLDOWN | MUX_MODE7)	/* cam0_data2 */
			0x214 (PIN_INPUT_PULLDOWN | MUX_MODE7)	/* cam0_data3 */
			0x220 (PIN_INPUT_PULLDOWN | MUX_MODE7)	/* cam0_data6 */
			0x224 (PIN_INPUT_PULLDOWN | MUX_MODE7)	/* cam0_data7 */
			0x238 (PIN_INPUT_PULLDOWN | MUX_MODE7)	/* gpio5_8 */
			0x23C (PIN_INPUT_PULLDOWN | MUX_MODE7)	/* gpio5_9 */
			0x240 (PIN_INPUT_PULLDOWN | MUX_MODE7)	/* gpio5_10 */
			0x244 (PIN_INPUT_PULLDOWN | MUX_MODE7)	/* gpio5_11 */
			0x248 (PIN_INPUT_PULLDOWN | MUX_MODE7)	/* gpio5_12 */
			0x24C (PIN_INPUT_PULLDOWN | MUX_MODE7)	/* gpio5_13 */
			0x250 (PIN_INPUT_PULLDOWN | MUX_MODE7)	/* spi4_sclk */
			0x254 (PIN_INPUT_PULLDOWN | MUX_MODE7)	/* spi4_d0 */
			0x258 (PIN_INPUT_PULLDOWN | MUX_MODE7)	/* spi4_d1 */
			0x25C (PIN_INPUT_PULLDOWN | MUX_MODE7)	/* spi4_cs0 */
			0x260 (PIN_INPUT_PULLDOWN | MUX_MODE7)	/* spi2_sclk */
			0x268 (PIN_INPUT_PULLDOWN | MUX_MODE7)	/* spi2_d1 */
			0x26C (PIN_INPUT_PULLDOWN | MUX_MODE7)	/* spi2_cs0 */
			0x278 (PIN_INPUT_PULLDOWN | MUX_MODE7)	/* xdma_evt_intr1 */
			0x27C (PIN_INPUT | PULL_DISABLE)	/* nresetin_out */
		>;
	};

	usb1_pins_default: usb1_pins_default {
		pinctrl-single,pins = <
			0x2c0 (DS0_PULL_UP_DOWN_EN | PIN_INPUT_PULLDOWN | MUX_MODE0)
		>;
	};

	usb1_pins_sleep: usb1_pins_sleep {
		pinctrl-single,pins = <
			0x2c0 (DS0_PULL_UP_DOWN_EN | PIN_INPUT_PULLDOWN | MUX_MODE7)
		>;
	};

	usb2_pins_default: usb2_pins_default {
		pinctrl-single,pins = <
			0x2c4 (DS0_PULL_UP_DOWN_EN | PIN_INPUT_PULLDOWN | MUX_MODE0)
		>;
	};

	usb2_pins_sleep: usb2_pins_sleep {
		pinctrl-single,pins = <
			0x2c4 (DS0_PULL_UP_DOWN_EN | PIN_INPUT_PULLDOWN | MUX_MODE7)
		>;
	};
};

// i2c1 is incorrectly laid out on macho man rev a, sda and scl are switched.
// we'll use a gpio i2c here instead.
//&i2c1 {
//	status = "okay";
//	pinctrl-names = "default";
//	pinctrl-0 = <&i2c1_pins>;
//	clock-frequency = <100000>;
//};

&i2c0 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&i2c0_pins>;
	clock-frequency = <100000>;
	
	rtc_sys: pcf8523 {
		compatible = "nxp,pcf8523";
		status = "okay";
		reg = <0x68>;
	};
};

&i2c2 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&i2c2_pins>;
	clock-frequency = <100000>;

	ioexp_top_0: ioexp@27 {
		status = "okay";
		compatible = "ti,tca9555";
		reg = <0x27>;
	};

	edt-ft5306@38 {
		status = "okay";
		compatible = "edt,edt-ft5306", "edt,edt-ft5x06";
		pinctrl-names = "default";
		pinctrl-0 = <&edt_ft5xx6_ts_pins>;
		reg = <0x38>;

		/* This is what am437x-sk-evm.dts does but the device driver
		 * code seems to be looking for irq-gpios...
		 */
		interrupt-parent = <&gpio3>;
		interrupts = <22 0>;

		/* Should just match the screen resolution */
		touchscreen-size-x = <800>;
		touchscreen-size-y = <480>;
	};
};

&tscadc {
	status = "okay";

    adc {
    	ti,adc-channels = <0 1 2 3 4 5 6 7>;
    };
};

&magadc {
	status = "okay";

	mag {
		ti,tracks = <0>;
	};

	adc {
		ti,adc-channels = <0 1 2 3 4 5 6 7>;
	};
};

&epwmss1 {
	status = "okay";
	ehrpwm1: pwm@48302200 {
		status = "okay";
		pinctrl-names = "default";
		pinctrl-0 = <&ehrpwm1_pins>;
	};
};

&epwmss3 {
	status = "okay";
	ehrpwm3: pwm@48306200 {
		status = "okay";
		pinctrl-names = "default";
		pinctrl-0 = <&ehrpwm3_pins>;
	};
};

&epwmss5 {
	status = "okay";
	ehrpwm5: pwm@4830a200 {
		status = "okay";
		pinctrl-names = "default";
		pinctrl-0 = <&ehrpwm5_pins>;
	};
};

&gpio0 {
	status = "okay";
};

&gpio1 {
	status = "okay";
};

&gpio2 {
	status = "okay";
};

&gpio3 {
	status = "okay";
};

&gpio4 {
	status = "okay";
};

&gpio5 {
	status = "okay";
};

/* eMMC sits on mmc2 */
&mmc2 {
	status = "okay";
	vmmc-supply = <&evm_v3_3d>;
	bus-width = <8>;
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&emmc_pins_default>;
	pinctrl-1 = <&emmc_pins_sleep>;
};

&usb2_phy1 {
	status = "okay";
};

&usb1 {
	dr_mode = "otg";
	status = "okay";
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&usb1_pins_default>;
	pinctrl-1 = <&usb1_pins_sleep>;
};

&usb2_phy2 {
	status = "okay";
};

&usb2 {
	dr_mode = "host";
	status = "okay";
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&usb2_pins_default>;
	pinctrl-1 = <&usb2_pins_sleep>;
};

&mac {
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&cpsw_default>;
	pinctrl-1 = <&cpsw_sleep>;
	active_slave = <1>;
	status = "okay";
};

&davinci_mdio {
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&davinci_mdio_default>;
	pinctrl-1 = <&davinci_mdio_sleep>;
	status = "okay";
};

// we're not using this but let's avoid boot time complaints
&cpsw_emac0 {
	phy_id = <&davinci_mdio>, <0>;
	phy-mode = "mii";
};

&cpsw_emac1 {
	phy_id = <&davinci_mdio>, <1>;
	phy-mode = "mii";
};

&uart0 {
	status = "okay";
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&uart0_pins_default>;
	pinctrl-1 = <&uart0_pins_sleep>;
};

&wkup_m3_ipc {
	ti,set-io-isolation;
	ti,scale-data-fw = "am43x-evm-scale-data.bin";
};

&rtc {
	status = "okay";
	ext-clk-src;
};

&pruss0 {
	pinctrl-names = "default";
	pinctrl-0 = <&pruss_pins>;
};

&dss {
	status = "okay";
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&dss_pins_default>;
	pinctrl-1 = <&dss_pins_sleep>;

	port {
		dpi_out: endpoint@0 {
			remote-endpoint = <&lcd_in>;
			data-lines = <16>;
		};
	};
};

/* TODO: This clearly belongs in dss and not in the root node.
 *       But the dss is poorly written so this cannot go there.
 */
/ {
	lcd0: display@0 {
		compatible = "omapdss,panel-dpi", "panel-dpi";
		label = "lcd";
		status = "okay";
		/* This is the backlight, not really an enable... */
		enable-gpios = <&gpio5 1 GPIO_ACTIVE_HIGH>;

		port {
			lcd_in: endpoint {
				remote-endpoint = <&dpi_out>;
			};
		};

		/* Mostly from the panel-dpi example */
		panel-timing {
			clock-frequency = <33000000>;
			hactive = <800>;
			vactive = <480>;
			hfront-porch = <40>;
			hback-porch = <40>;
			hsync-len = <48>;
			vback-porch = <29>;
			vfront-porch = <13>;
			vsync-len = <3>;

			hsync-active = <0>;
			vsync-active = <0>;
			de-active = <1>;
			pixelclk-active = <0>;
		};
	};
};
