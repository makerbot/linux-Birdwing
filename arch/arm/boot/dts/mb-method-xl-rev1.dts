/* AM437x GP EVM */

/dts-v1/;

#include "mb-method-rev1-common.dtsi"

// For Pin Mux Modes, refer to the TI AM437x Processors Datasheet (am4376.pdf)

/ {
	model = "MakerBot Method XL GEN-2";
	compatible = "makerbot,method-rev1", "ti,am4372", "ti,am43", "ti,cpsw";
};

&am43xx_pinmux {
	/delete-property/ehrpwm3_pins;  /* magma machines do not use this */

	mobo_usb_hub_reset_pins: mobo_usb_hub_reset_pins {
		pinctrl-single,pins = <
			0x21C (PIN_OUTPUT_PULLUP | MUX_MODE7) /* (AD19) cam0_data5.gpio4_27 MOBO-USB-HUB-GRSTz */
		>;
	};
};

&epwmss3 {
	status = "disabled";
	ehrpwm3: pwm@48306200 {
		status = "disabled";
	};
};
